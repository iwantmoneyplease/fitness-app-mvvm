<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fitness_app_mvvm.View.GoalPage"
             Title="Previous workouts">
    <VerticalStackLayout Padding="20">

        <Entry 
        Placeholder="Skriv ditt mål..."
        Text="{Binding GoalText}" />

        <Button 
        Text="Spara mål"
        Command="{Binding SaveGoalCommand}" />

        <CollectionView ItemsSource="{Binding Goals}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="5" Padding="10">
                        <Label Text="{Binding GoalText}" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>