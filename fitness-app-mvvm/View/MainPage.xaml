<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fitness_app_mvvm.View.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            <Image Source="bicep_curl.jpg" Aspect="AspectFit" Margin="0,0,0,20"/>
            <Label Text="{Binding DisplayName, StringFormat='Hej {0}!'}" />
            <CollectionView ItemsSource="{Binding Workouts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="5" Padding="10" BorderColor="Gray">
                            <VerticalStackLayout>
                                <Label Text="{Binding Sort}" FontAttributes="Bold"/>
                                <Label Text="{Binding Time, StringFormat='Tid: {0} min'}" />
                                <Label Text="{Binding Quantity, StringFormat='Antal: {0}'}" />

                                <Label Text="{Binding GetDesc}" TextColor="Gray" FontSize="Caption"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
